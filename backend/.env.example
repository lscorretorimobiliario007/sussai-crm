DATABASE_URL="postgresql://usuario:senha@localhost:5432/sussai_crm"
JWT_SECRET="sua-chave-secreta-aqui-mude-em-producao"
PORT=3000
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"
UPLOAD_DIR="uploads"
ALLOW_PUBLIC_SIGNUP="true"
# Em produção, deixe false (ou omita). Só habilite demo com ALLOW_DEMO=true
# ALLOW_DEMO="false"
# Empresa publicada no site Top Conceição (ID numérico)
SITE_EMPRESA_ID="1"
# URL pública absoluta da API (fotos /uploads). Em produção: https://api.topconceicao.com.br
# PUBLIC_BASE_URL="http://localhost:3000"

# Produção (ver docs/DEPLOY_GUIDE.md):
# NODE_ENV="production"
# ALLOW_PUBLIC_SIGNUP="false"
# ALLOW_DEMO="false"
# CORS_ORIGIN="https://crm.seudominio.com.br,https://www.seudominio.com.br"
# DATABASE_URL="postgresql://...?sslmode=require"
# JWT_SECRET="<openssl rand -base64 48>"
# UPLOAD_DIR="/var/sussai/uploads"
