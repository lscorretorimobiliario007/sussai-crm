DATABASE_URL="postgresql://usuario:senha@localhost:5432/sussai_crm"
JWT_SECRET="sua-chave-secreta-aqui-mude-em-producao"
PORT=3000
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"
UPLOAD_DIR="uploads"
ALLOW_PUBLIC_SIGNUP="true"
# Empresa publicada no site Top Conceição (ID numérico)
SITE_EMPRESA_ID="1"

