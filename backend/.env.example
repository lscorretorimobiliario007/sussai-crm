DATABASE_URL="postgresql://usuario:senha@localhost:5432/sussai_crm"
JWT_SECRET="sua-chave-secreta-aqui-mude-em-producao"
JWT_EXPIRES_IN="1d"
PORT=3000
NODE_ENV="development"

# CORS: obrigatório em produção (lista separada por vírgula). Sem valor em prod o boot falha.
# Em development, se vazio, o Nest reflete o Origin do request (localhost e 127.0.0.1).
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001"

# Diretório absoluto ou relativo para arquivos enviados (avatars, imóveis, docs).
UPLOAD_DIR="uploads"

# URL pública do backend (prefixa URLs de upload quando definida).
PUBLIC_BASE_URL="http://localhost:3000"

# Cadastro público via POST /api/auth/registrar.
# Em produção só funciona se for explicitamente "true" (fail-closed).
ALLOW_PUBLIC_SIGNUP="false"

# Login demo (POST /api/auth/demo). Em produção exige "true".
ALLOW_DEMO="false"

# Empresa publicada no site público (ID numérico).
SITE_EMPRESA_ID="1"

# Provider de IA (desligado por padrão).
AI_ENABLED="false"

# Produção (ver docs/DEPLOY_GUIDE.md):
# NODE_ENV="production"
# ALLOW_PUBLIC_SIGNUP="false"
# ALLOW_DEMO="false"
# CORS_ORIGIN="https://crm.seudominio.com.br,https://www.seudominio.com.br"
# PUBLIC_BASE_URL="https://api.seudominio.com.br"
# DATABASE_URL="postgresql://...?sslmode=require"
# JWT_SECRET="<openssl rand -base64 48>"
# UPLOAD_DIR="/var/sussai/uploads"
